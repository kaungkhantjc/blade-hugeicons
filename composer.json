{
    "name": "kaungkhantjc/blade-hugeicons",
    "description": "A package to easily make use of free Hugeicons in your Laravel Blade views.",
    "keywords": ["Blade", "Hugeicons", "Laravel"],
    "homepage": "https://github.com/kaungkhantjc/blade-hugeicons",
    "license": "MIT",
    "authors": [
        {
            "name": "Kaung Khant Kyaw",
            "email": "kaungkhantjc@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "blade-ui-kit/blade-icons": "^1.9",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "KaungKhantKyaw\\HugeIcons\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "KaungKhantKyaw\\HugeIcons\\BladeHugeIconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
